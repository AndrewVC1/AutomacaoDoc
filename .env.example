# Copie este arquivo para .env e preencha com os seus dados.
# O .env fica fora do Git. Este exemplo pode ir para o repositório.

# Credenciais da WhatsApp Business Cloud API (Meta)
# Token temporário expira em cerca de 24 horas. Não commite o valor real.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Versão da Graph API alinhada ao app no Meta
WHATSAPP_GRAPH_API_VERSION=v24.0

# true = envia pelo template aprovado (recomendado)
# false = envia documento com legenda livre (só dentro da janela de 24h)
WHATSAPP_USE_MESSAGE_TEMPLATE=true
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_DOCUMENT_FILENAME=

# Pastas locais. Deixe em branco para usar o padrão do config.py.
PASTA_EXCEL=C:/PlanilhaRelatorios
PASTA_PDFS=C:/Relatoriosautomatizados
# Caminho de um Excel específico. Vazio = primeiro .xlsx de PASTA_EXCEL.
EXCEL_CLIENTES=
LOG_DIR=logs

# Usada só quando WHATSAPP_USE_MESSAGE_TEMPLATE=false
MENSAGEM_TEMPLATE="Olá, {nome}, segue seu relatório referente ao período {periodo}."

# Servidor do webhook (webhook.py)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
